# Copy to server/.env (never commit it) or set these in Coolify's environment tab.
# Generate each secret with:  openssl rand -hex 32
PUBLIC_HOST=play.example.com
POSTGRES_PASSWORD=
NAKAMA_SERVER_KEY=
NAKAMA_SESSION_KEY=
NAKAMA_REFRESH_KEY=
NAKAMA_HTTP_KEY=
NAKAMA_CONSOLE_PASSWORD=
NAKAMA_CONSOLE_KEY=
# Optional
RK_INVITE_ONLY=false
# A one-time code; the first account to enter it becomes the Creator (owner).
RK_CREATOR_CODE=
